# Backend Environment Variables

# Required for all deployments
MONGODB_URI=mongodb://localhost:27017/motherina
PORT=3000
CORS_ORIGINS=http://localhost:5173,https://akultyagi11.github.io
APP_TIMEZONE=Asia/Kolkata

# Admin bootstrap and login
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Motherina <no-reply@example.com>
CLINIC_NOTIFICATION_EMAIL=

# Optional: Google Calendar Integration
# Set GOOGLE_CALENDAR_ENABLED=true to enable automatic calendar sync
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary

# Notes:
# - MONGODB_URI: Connection string to your MongoDB instance
# - PORT: Server port (default: 3000)
# - CORS_ORIGINS: Comma-separated list of allowed origins for CORS
# - APP_TIMEZONE: Business timezone used for authoring/displaying availability
# - ADMIN_EMAIL / ADMIN_PASSWORD: Used to bootstrap the first admin account
# - SMTP_*: If SMTP_HOST is unset, email delivery is skipped safely
# - Google Calendar credentials: Obtain from Google Cloud Console
#   1. Create a service account
#   2. Enable Google Calendar API
#   3. Download JSON key file
#   4. Extract client_email and private_key values
#   5. Share your Google Calendar with the service account email
